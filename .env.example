# ─── REQUIRED ────────────────────────────────────────────────────────────────

# Postgres with the pgvector extension.
#  - Supabase: Project Settings → Database → Connection string (URI). Use the
#    "Session pooler" string if your network has no IPv6.
#  - Local (docker compose / Postgres.app): postgresql://postgres:postgres@localhost:5432/codeatlas
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codeatlas

# Voyage AI key (voyage-code-3 code embeddings) — https://dashboard.voyageai.com/
VOYAGE_API_KEY=

# Anthropic key (Claude answers) — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ─── OPTIONAL ────────────────────────────────────────────────────────────────

# Claude model id (default: claude-sonnet-5-5)
# CLAUDE_MODEL=claude-sonnet-5-5

# GitHub personal access token — only needed for PRIVATE repos (or to avoid rate limits)
# GITHUB_TOKEN=

# Allowed frontend origins for CORS (comma-separated)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL connection string with pgvector support (e.g. Supabase, Neon, or local Postgres)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Voyage AI API Key for voyage-code-3 embeddings (1024-dim code vectors)
VOYAGE_API_KEY=pa-voyage-code-3-key-placeholder

# Anthropic API Key for Claude 3.5 Sonnet streaming RAG responses
ANTHROPIC_API_KEY=sk-ant-api-key-placeholder

# (Optional) Model override for Anthropic Claude (defaults to claude-3-5-sonnet-20241022)
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# (Optional) FastAPI Backend Server Port
PORT=8000
